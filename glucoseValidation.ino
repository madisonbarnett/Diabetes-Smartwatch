// ----------------CEGA MAPPING--------------------
char get_cega_zone(float r, float p) {
  // Zone A
  if ((r <= 70 && p <= 70) || (p >= 0.8 * r && p <= 1.2 * r)) {
    return 'A';
  }

  // Zone C
  if ((r > 130 && r <= 180 && p <= 1.4 * (r - 130)) ||
      (r > 70 && r <= 280 && p >= (r + 110))) {
    return 'C';
  }

  // Zone D
  if ((r <= 70 && p > 70 && p <= 180) ||
      (r >= 240 && p >= 70 && p <= 180)) {
    return 'D';
  }

  // Zone E
  if ((r <= 70 && p > 180) ||
      (r > 180 && p <= 70)) {
    return 'E';
  }

  // Zone B (default)
  return 'B';
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);
  delay(2000);

  tensor_arena = (uint8_t*)malloc(kTensorArenaSize);
  if (!tensor_arena) {
    Serial.println("Tensor arena allocation failed");
    return;
  }

  tflite::InitializeTarget();

  model = tflite::GetModel(model_weights_mlp_15s_vitaldb_int8_tflite);

  static tflite::AllOpsResolver resolver;
  static tflite::MicroErrorReporter micro_error_reporter;

  static tflite::MicroInterpreter static_interpreter(
      model, resolver, tensor_arena, kTensorArenaSize, &micro_error_reporter);

  interpreter = &static_interpreter;

  if (interpreter->AllocateTensors() != kTfLiteOk) {
    Serial.println("AllocateTensors failed");
    return;
  }

  input = interpreter->input(0);
  output = interpreter->output(0);

  model_ready = true;
}

// ---------------- LOOP ----------------
void loop() {
  if (!model_ready) return;

  float in_scale = input->params.scale;
  int in_zero_point = input->params.zero_point;

  float out_scale = output->params.scale;
  int out_zero_point = output->params.zero_point;

  Serial.println("\nRunning validation...\n");

  float total_error = 0;
  float total_percentage_error = 0;

  int zoneA = 0, zoneB = 0, zoneC = 0, zoneD = 0, zoneE = 0;

  for (int row = 0; row < 100; row++) {

    for (int i = 0; i < 12; i++) {
      int8_t quantized = (int8_t)(((input_data[row][i] - standardmean[i]) / standardscalar[i] / in_scale) + in_zero_point); // Full scalar test suite
      // quantized = (int8_t)(((input_data[row][i]) - standardmean[i]) / standardscalar[i]);                                   // No input scalers
      quantized = (int8_t)(input_data[row][i]);                                                                             // Raw data *OPTIMAL*
      // quantized = (int8_t)((input_data[row][i] / in_scale) + in_zero_point);                                                // No feature scale/mean
      input->data.int8[i] = quantized;
    }

    if (interpreter->Invoke() != kTfLiteOk) {
      Serial.println("Invoke failed");
      continue;
    }

    int8_t raw = output->data.int8[0];
    float predicted = (raw - out_zero_point) * out_scale;
    predicted = raw; // Used for raw input/outputs *OPTIMAL*

    float actual = actual_glucose[row];
    float error = abs(predicted - actual);
    total_error += error;

    // Avoid divide-by-zero
    if (actual != 0) {
      float pct_error = error / actual;
      total_percentage_error += pct_error;
    }

    char zone = get_cega_zone(actual, predicted);
    
    switch(zone) {
      case 'A': zoneA++; break;
      case 'B': zoneB++; break;
      case 'C': zoneC++; break;
      case 'D': zoneD++; break;
      case 'E': zoneE++; break;
    }

    Serial.print("Row ");
    Serial.print(row);
    Serial.print(" | Pred: ");
    Serial.print(predicted);
    Serial.print(" | Actual: ");
    Serial.print(actual);
    Serial.print(" | Error: ");
    Serial.println(error);

    delay(10);
  }

  float mae = total_error / 100.0;
  float mape = (total_percentage_error / 100.0) * 100.0;

  Serial.println("\n=================");
  Serial.print("MAE: ");
  Serial.println(mae);
  Serial.print("MAPE: ");
  Serial.println(mape);
  Serial.println("\n===== CEGA RESULTS =====");
  Serial.print("Zone A: ");
  Serial.print(zoneA);
  Serial.println("%");

  Serial.print("Zone B: ");
  Serial.print(zoneB);
  Serial.println("%");

  Serial.print("Zone C: ");
  Serial.print(zoneC);
  Serial.println("%");

  Serial.print("Zone D: ");
  Serial.print(zoneD);
  Serial.println("%");

  Serial.print("Zone E: ");
  Serial.print(zoneE);
  Serial.println("%");

  Serial.println("====================");

  while (true);
}