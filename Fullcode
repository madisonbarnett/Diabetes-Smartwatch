bool max30102_active = false;

void enableMAX30102() {
  if (max30102_active) return;
  I2C_2.begin(7, 8);
  if (!particleSensor.begin(I2C_2, I2C_SPEED_STANDARD)) {
    Serial.println("MAX30102 not found!");
    return;  // ← sampling will run but collect 0 samples
  }
  // Explicit 100 Hz, no sample averaging — fixes low sample count
  particleSensor.setup(0x1F, 1, 2, 100, 411, 4096);
  max30102_active = true;
}

void disableMAX30102() {
  if (!max30102_active) return;
  particleSensor.shutDown();
  max30102_active = false;
}

// ================= AI =================

void setupAI() {
  tensor_arena = (uint8_t*)malloc(kTensorArenaSize);
  if (tensor_arena == nullptr) { Serial.println("Failed to allocate tensor arena"); return; }

  tflite::InitializeTarget();

  tfl_model = tflite::GetModel(model_weights_mlp_hist_15s_vitaldb_int8_tflite);
  if (tfl_model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.println("Model schema version mismatch");
    return;
  }

  static tflite::AllOpsResolver resolver;
  static tflite::MicroErrorReporter micro_error_reporter;
  static tflite::MicroInterpreter static_interpreter(
      tfl_model, resolver, tensor_arena, kTensorArenaSize, &micro_error_reporter);
  interpreter = &static_interpreter;

  if (interpreter->AllocateTensors() != kTfLiteOk) {
    Serial.println("AllocateTensors() failed");
    return;
  }

  tfl_input  = interpreter->input(0);
  tfl_output = interpreter->output(0);
  model_ready = true;
  Serial.println("AI model ready");
}

// Runs inference using current feature globals and profile values.
// Input order must match training pipeline exactly.
float runInference() {
  if (!model_ready) return -1.0f;

  float in_scale      = tfl_input->params.scale;
  int   in_zero_point = tfl_input->params.zero_point;

  tfl_input->data.int8[0]  = (int8_t)(((float)values[0] / in_scale) + in_zero_point); // Age
  tfl_input->data.int8[1]  = (int8_t)(((float)values[3] / in_scale) + in_zero_point); // Weight
  tfl_input->data.int8[2]  = (int8_t)(((float)values[2] / in_scale) + in_zero_point); // Height
  tfl_input->data.int8[3]  = (int8_t)(((float)values[4] / in_scale) + in_zero_point); // PreOpDm (Diagnosis)
  tfl_input->data.int8[4]  = (int8_t)((meanP2Pinterval  / in_scale) + in_zero_point); // PPGMEANINTERVAL
  tfl_input->data.int8[5]  = (int8_t)((stddev           / in_scale) + in_zero_point); // PPGSTD
  tfl_input->data.int8[6]  = (int8_t)((teager_max       / in_scale) + in_zero_point); // PPGTEAGER
  tfl_input->data.int8[7]  = (int8_t)((skewness         / in_scale) + in_zero_point); // PPGSKEW
  tfl_input->data.int8[8]  = (int8_t)((iqr              / in_scale) + in_zero_point); // PPGIQR
  tfl_input->data.int8[9]  = (int8_t)((entropy          / in_scale) + in_zero_point); // PPGENTROPY
  tfl_input->data.int8[10] = (int8_t)((FIRST_DERIVMAX   / in_scale) + in_zero_point); // PPGFIRSTDERIVMAX
  tfl_input->data.int8[11] = (int8_t)((stddevTime       / in_scale) + in_zero_point); // PPGSTDPP

  if (interpreter->Invoke() != kTfLiteOk) { Serial.println("Invoke() failed"); return -1.0f; }

  int8_t raw = tfl_output->data.int8[0];
  float result = (raw - tfl_output->params.zero_point) * tfl_output->params.scale;
  Serial.print("AI result: ");
  Serial.println(result);
  return result;
}

// ================= FEATURE FUNCTIONS =================

void NORMALIZE_SIGNAL() {
  mean = 0;
  for (int j = 0; j < i; j++) mean += irarray[j];
  mean /= (float)i;
  stddev = 0;
  for (int j = 0; j < i; j++) stddev += sq(irarray[j] - mean);
  stddev = sqrt(stddev / (float)i);
  if (stddev == 0) {
    for (int j = 0; j < i; j++) norm_ir[j] = 0;
  } else {
    for (int j = 0; j < i; j++) norm_ir[j] = (irarray[j] - mean) / stddev;
  }
}

void FIRST_DERIV_MAX() {
  FIRST_DERIVMAX = -1e30;
  for (int j = 1; j < i; j++) {
    float deriv = norm_ir[j] - norm_ir[j - 1];
    if (deriv > FIRST_DERIVMAX) FIRST_DERIVMAX = deriv;
  }
}

void SKEWNESS_CALC() {
  float norm_mean = 0;
  for (int j = 0; j < i; j++) norm_mean += norm_ir[j];
  norm_mean /= (float)i;
  float norm_std = 0;
  for (int j = 0; j < i; j++) norm_std += sq(norm_ir[j] - norm_mean);
  norm_std = sqrt(norm_std / (float)i);
  skewness = 0;
  if (norm_std == 0) return;
  for (int j = 0; j < i; j++) {
    float temp = (norm_ir[j] - norm_mean) / norm_std;
    skewness += temp * temp * temp;
  }
  skewness = ((float)i / ((float)(i - 1) * (float)(i - 2))) * skewness;
}

void IQR_CALC() {
  static float temp[3000];
  for (int j = 0; j < i; j++) temp[j] = norm_ir[j];
  for (int a = 0; a < i - 1; a++)
    for (int b = a + 1; b < i; b++)
      if (temp[b] < temp[a]) { float t = temp[a]; temp[a] = temp[b]; temp[b] = t; }
  auto percentile_interp = [&](float pct) -> float {
    float idx = pct * (float)(i - 1);
    int lo = (int)idx, hi = lo + 1;
    if (hi >= i) return temp[i - 1];
    return temp[lo] + (idx - (float)lo) * (temp[hi] - temp[lo]);
  };
  iqr = percentile_interp(0.75f) - percentile_interp(0.25f);
}

void TEAGER_ENERGY() {
  if (i < 3) { teager_max = 0; return; }
  float sum = 0; int count = 0;
  for (int j = 1; j < i - 1; j++) {
    sum += fabsf(norm_ir[j] * norm_ir[j] - norm_ir[j - 1] * norm_ir[j + 1]);
    count++;
  }
  teager_max = (count > 0) ? sum / (float)count : 0;
}

void POWEROF2() {
  h = 1;
  while ((h << 1) <= i) h <<= 1;
}

void FFT_SPECTRAL() {
  SAMPLES = h;
  vReal = new double[SAMPLES];
  vImag = new double[SAMPLES];
  for (int j = 0; j < SAMPLES; j++) { vReal[j] = (j < i) ? norm_ir[j] : 0.0; vImag[j] = 0.0; }
  if (FFT != NULL) { delete FFT; FFT = NULL; }
  FFT = new ArduinoFFT<double>(vReal, vImag, SAMPLES, SAMPLING_FREQUENCY);
  FFT->compute(FFTDirection::Forward);
  FFT->complexToMagnitude();
  int n_bins = SAMPLES / 2 + 1;
  float psd_sum = 0;
  for (int j = 0; j < n_bins; j++) { vReal[j] = vReal[j] * vReal[j]; psd_sum += vReal[j]; }
  entropy = 0;
  if (psd_sum > 0)
    for (int l = 0; l < n_bins; l++) {
      float k = vReal[l] / psd_sum;
      if (k > 0) entropy -= k * log(k);
    }
  delete FFT; FFT = NULL;
  delete[] vReal; vReal = NULL;
  delete[] vImag; vImag = NULL;
}

void TIME_STD_DEV() {
  if (p == 0) { stddevTime = 0; return; }
  meanP2Pinterval = 0;
  for (int j = 0; j < p; j++) meanP2Pinterval += P2PTime_Array[j];
  meanP2Pinterval /= (float)p;
  stddevTime = 0;
  for (int j = 0; j < p; j++) stddevTime += sq(P2PTime_Array[j] - meanP2Pinterval);
  stddevTime = sqrt(stddevTime / (float)p);
}

// ================= SAMPLING =================

void runSampling() {
  i = 0; p = 0; lastBeat = 0; beatAvg = 0; h = 0;
  FIRST_DERIVMAX = 0; FIRST_DERIV = 0;
  mean = 0; stddev = 0; skewness = 0;
  iqr = 0; teager = 0; teager_max = 0;
  initial = millis();

  while ((millis() - initial) < 30000 && i < 3000) {
    particleSensor.check();
    while (particleSensor.available()&& i < 3000) {
      uint32_t ir = particleSensor.getIR();
      irarray[i] = ir;
      timearray[i] = millis();
      if (checkForBeat(ir)) {
        long delta = millis() - lastBeat;
        lastBeat = millis();
        if (p < 3000) { P2PTime_Array[p] = delta / 1000; p++; }
        beatsPerMinute = 60 / (delta / 1000.0);
        if (beatsPerMinute < 255 && beatsPerMinute > 20) {
          rates[rateSpot++] = (byte)beatsPerMinute;
          rateSpot %= RATE_SIZE;
          beatAvg = 0;
          for (byte x = 0; x < RATE_SIZE; x++) beatAvg += rates[x];
          beatAvg /= RATE_SIZE;
        }
      }
      arraysize[i] = i;
      i++;
      particleSensor.nextSample();
    }
    delay(1);
  }
}

